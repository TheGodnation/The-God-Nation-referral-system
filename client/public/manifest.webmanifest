{
  "name": "The God Nation",
  "short_name": "The God Nation",
  "id": "/",
  "start_url": "/member/chats",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0f2260",
  "description": "The God Nation: a community of disciples learning, praying and growing together — leadership school, Dominion Clinic, chats and giving, in English and French.",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".mp4",
            ".mp3",
            ".m4a",
            ".ogg",
            ".opus",
            ".aac",
            ".pdf"
          ]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://thegodnationacademy.org/manifest.webmanifest"
    }
  ],
  "categories": [
    "education",
    "lifestyle",
    "social"
  ],
  "shortcuts": [
    {
      "name": "Chats",
      "short_name": "Chats",
      "url": "/member/chats",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Learn",
      "short_name": "Learn",
      "url": "/member/learn",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "King's Tokens",
      "short_name": "Tokens",
      "url": "/member/tokens",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
