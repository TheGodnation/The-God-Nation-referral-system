{
  "name": "The God Nation",
  "short_name": "The God Nation",
  "id": "/",
  "start_url": "/member/chats",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0f2260",
  "description": "Be Equipped. Be Transformed. Be Sent. Register and join our WhatsApp community.",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".mp4",
            ".mp3",
            ".m4a",
            ".ogg",
            ".opus",
            ".aac",
            ".pdf"
          ]
        }
      ]
    }
  }
}
