# -----------------------------------------------------------------------
# The God Nation Referral System — environment configuration example
# Copy this file to .env (and server/.env) and fill in real values.
# Never commit a real .env file.
# -----------------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/godnation?schema=public"

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# Public base URL of the API server (used for links/redirects if needed)
APP_URL="http://localhost:4000"

# Public base URL of the client app (used to build referral links, CORS)
CLIENT_URL="http://localhost:5173"

# Optional: overrides for `npm run seed`
# SEED_ADMIN_EMAIL="admin@thegodnation.org"
# SEED_WHATSAPP_URL_EN="https://chat.whatsapp.com/your-english-invite"
# SEED_WHATSAPP_URL_FR="https://chat.whatsapp.com/your-french-invite"

# NOTE: WhatsApp community URLs (Training + Discover & Grow, x2 languages),
# the support WhatsApp link, social media links, and homepage/pathway copy
# are NOT configured via environment variables — they are configured by an
# Admin through the Admin Settings / Website Content pages (the Settings
# table) so they can be changed without a redeploy. The SEED_* values above
# only seed initial placeholder Training URLs for local development.

# -----------------------------------------------------------------------
# Email (Resend) — server-side only, exactly like DATABASE_URL. Never
# exposed to the client, never hardcoded, never committed with a real value.
# -----------------------------------------------------------------------

# Resend API key used to send Leader invitations, registration
# confirmations, password resets, and Leader referral-invitation emails.
# Get one at https://resend.com — without it, email sending is skipped
# (logged, not fatal) so the rest of the app still works.
RESEND_API_KEY=""

# Sender address emails are sent from. Must be a sender your Resend account
# is actually allowed to send from (a verified domain, or Resend's own
# sandbox address if you haven't verified a domain yet). Do not invent one.
# EMAIL_FROM="The God Nation <onboarding@resend.dev>"
