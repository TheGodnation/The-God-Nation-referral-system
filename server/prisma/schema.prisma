generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
}

enum RegistrationStatus {
  ACTIVE
}

enum EventType {
  VISITED
  REGISTERED
  WHATSAPP_CLICKED
}

enum Language {
  en
  fr
}

enum Pathway {
  TRAINING
  DISCOVER_GROW
}

enum ContentPageType {
  PAGE
  TEACHING
  ANNOUNCEMENT
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// User / Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  isTestData   Boolean  @default(false)
  mustChangePassword Boolean @default(false)
  // True for a Leader who created their own account via the public
  // self-signup link (POST /api/auth/leader-signup), as opposed to one an
  // Admin created by hand in Admin > Leaders. Admin retains full control
  // either way — this is purely informational, shown as a badge.
  selfRegistered Boolean @default(false)
  // Phase 3A: optional link to the person's unified God Nation identity.
  // Left null for every existing User by the Phase 3A backfill — a User's
  // email alone is never treated as proof of identity with a Person (see
  // Person model comment), so this is populated only when a future,
  // explicit, safe linking step establishes the relationship.
  personId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  person         Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  sessions       Session[]
  referralCodes  ReferralCode[]
  referralRelationships ReferralRelationship[]
  setupTokens         LeaderSetupToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([personId])
}

// Secure one-time invitation token for new Leader onboarding (section 27-29).
// Only the hash is ever stored; the raw token exists only long enough to be
// emailed. Expires 7 days after issuance, single-use.
model LeaderSetupToken {
  id         String    @id @default(uuid())
  leaderId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  leader User @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  @@index([leaderId])
}

// Secure one-time password-reset token (section 33). Only the hash is ever
// stored. Expires 1 hour after issuance, single-use.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  success    Boolean
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// Referral system
// ---------------------------------------------------------------------------

model ReferralCode {
  id            String    @id @default(uuid())
  code          String    @unique
  leaderId      String
  active        Boolean   @default(true)
  isTestData    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  leader        User            @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  visits        ReferralVisit[]
  relationships ReferralRelationship[]

  @@index([leaderId])
  @@index([active])
}

model ReferralVisit {
  id             String    @id @default(uuid())
  visitorId      String
  referralCodeId String?
  timestamp      DateTime  @default(now())
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  landingPage    String?
  language       Language  @default(en)
  isTestData     Boolean   @default(false)

  referralCode ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)

  @@index([visitorId, timestamp])
  @@index([referralCodeId, timestamp])
  @@index([timestamp])
  @@index([utmSource])
  @@index([utmCampaign])
}

model Registration {
  id                 String   @id @default(uuid())
  visitorId          String
  normalizedWhatsApp String   @unique
  name               String
  email              String?
  language           Language @default(en)
  pathway            Pathway  @default(TRAINING)
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  landingPage        String?
  status             RegistrationStatus @default(ACTIVE)
  isTestData         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
  // Phase 3A: link to the registrant's unified God Nation identity, keyed
  // by normalizedWhatsApp (see Person model). Populated automatically for
  // every new registration and backfilled for existing ones — never
  // changes any existing registration behavior or fields.
  personId           String?

  person       Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  relationship ReferralRelationship?
  events       Event[]

  @@index([visitorId])
  @@index([createdAt])
  @@index([language])
  @@index([personId])
}

model ReferralRelationship {
  id             String   @id @default(uuid())
  leaderId       String
  registrationId String   @unique
  referralCodeId String?
  createdAt      DateTime @default(now())

  leader       User          @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  referralCode ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)

  @@index([leaderId])
}

model Event {
  id             String    @id @default(uuid())
  type           EventType
  registrationId String?
  visitorId      String?
  timestamp      DateTime  @default(now())
  isTestData     Boolean   @default(false)

  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([type, timestamp])
  @@index([registrationId])
  @@index([visitorId])
}

// ---------------------------------------------------------------------------
// Settings / Audit
// ---------------------------------------------------------------------------

// Single settings row. whatsappUrlEn/Fr (pre-existing) are the TRAINING
// pathway destinations; whatsappUrlDiscoverEn/Fr are the new DISCOVER_GROW
// destinations. `content` holds the simple, admin-editable website copy
// (homepage/pathway/success/registration text) as a flat JSON object of
// known keys — deliberately not a full CMS; missing keys fall back to
// built-in defaults on the client.
model Settings {
  id                    String   @id @default("singleton")
  whatsappUrlEn         String?
  whatsappUrlFr         String?
  whatsappUrlDiscoverEn String?
  whatsappUrlDiscoverFr String?
  supportWhatsappUrl    String?
  facebookUrl           String?
  instagramUrl          String?
  tiktokUrl             String?
  youtubeUrl            String?
  whatsappContactUrl    String?
  telegramUrl           String?
  messengerUrl          String?
  // Shared access phrase gating Leader self-signup (POST
  // /api/auth/leader-signup). Stored in plain text — the Admin needs to be
  // able to read it back to share it in the WhatsApp group, so it isn't a
  // password. Null/blank means self-signup is turned off entirely.
  leaderSignupPhrase    String?
  content               Json?
  // Recipient address for the public Contact form (Phase 2). Admin-editable;
  // never sent to the client. Null/blank means the contact form is disabled.
  contactEmail          String?
  updatedAt             DateTime @updatedAt
  updatedByUserId       String?
}

// ---------------------------------------------------------------------------
// Public content (Phase 2)
// ---------------------------------------------------------------------------

// Small, generic public content model — deliberately not a CMS. Used for
// Vision/Mission/Our Story pages, Teachings, Announcements, and expanded
// Training / Discover & Grow information. Bilingual fields follow the same
// En/Fr-suffix convention as Settings.content. `mediaUrl` covers embedded
// video/audio or a link to existing external media without a separate
// media-management system.
model ContentPage {
  id          String          @id @default(uuid())
  type        ContentPageType @default(PAGE)
  slug        String          @unique
  titleEn     String
  titleFr     String?
  bodyEn      String
  bodyFr      String?
  mediaUrl    String?
  published   Boolean         @default(false)
  order       Int             @default(0)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, published, order])
  @@index([published])
}

// Submissions from the public Contact form (Phase 2). Stored durably even
// if the notification email fails to send, consistent with the rest of the
// app's "never lose data on email failure" approach.
model ContactMessage {
  id          String   @id @default(uuid())
  name        String
  email       String
  message     String
  language    Language @default(en)
  emailSentAt DateTime?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Unified identity + geographic/online community foundation (Phase 3A)
// ---------------------------------------------------------------------------

// Represents the human being independently of authentication. The existing
// Phase 1 `User` (login/account) is unaffected — a Person may or may not
// ever have a User account. `whatsappNumber` (already-normalized E.164,
// same convention as Registration.normalizedWhatsApp) is the identity key:
// it is the one signal Phase 1 already guarantees is unique per person via
// Registration, so it is what every new Registration links against.
// Email is intentionally NOT unique and NOT treated as an identity
// key — matching emails between two records is never sufficient grounds to
// merge two identities (see the Phase 3A backfill in prisma/seed.ts and
// lib/person.ts for why).
//
// Deferred to a future phase (do not add speculatively now): a normal/
// primary contact phone number distinct from WhatsApp (confirmed future
// requirement for local leader offline contact), profile photo, date of
// birth, address fields, care fields, payment fields, leadership fields,
// follow-up fields.
model Person {
  id                String   @id @default(uuid())
  name              String
  whatsappNumber    String   @unique
  email             String?
  preferredLanguage Language @default(en)
  // Mirrors the originating Registration's isTestData flag (when a Person
  // is created via the registration flow) so the Admin People list can use
  // the same "include test data" filter as every other list in the app.
  isTestData        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                 User[]
  registrations         Registration[]
  communityMemberships  CommunityMembership[]
  geographicAssignment  GeographicAssignment?

  @@index([isTestData])
}

// Represents an online God Nation community — participation, not location.
// Deliberately not geographically restricted: two members of the same
// Community may live in different countries (see schema-level docs in the
// Phase 3A spec). Self-referencing parent/child supports an arbitrarily
// deep Mother -> Child -> Grandchild hierarchy with no hard-coded depth
// limit. No leadership/capacity logic yet — that is a later phase.
model Community {
  id        String   @id @default(uuid())
  parentId  String?
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      Community?             @relation("CommunityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Community[]            @relation("CommunityHierarchy")
  memberships CommunityMembership[]

  @@index([parentId])
  @@index([active])
}

// Person <-> Community relationship. A given person can have at most one
// membership row per community (re-joining after leaving reactivates the
// same row via `status` rather than creating a duplicate), which is what
// prevents duplicate active memberships in the same community.
model CommunityMembership {
  id          String           @id @default(uuid())
  personId    String
  communityId String
  joinedAt    DateTime         @default(now())
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([personId, communityId])
  @@index([communityId])
}

// Represents a configurable geographic hierarchy — deliberately not
// hard-coded to any one country's administrative structure. `type` is a
// free-form label (e.g. COUNTRY, REGION, DIVISION, SUBDIVISION, QUARTER, or
// a different country's own labels such as STATE/COUNTY/DISTRICT) rather
// than a rigid enum, since different countries use different hierarchies.
// `countryCode` is deliberately denormalized onto every node (not just the
// root) so a country-scoped query never has to walk the parent chain.
model Geography {
  id          String   @id @default(uuid())
  parentId    String?
  name        String
  type        String
  countryCode String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Geography?             @relation("GeographyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Geography[]            @relation("GeographyHierarchy")
  assignments GeographicAssignment[]

  @@index([parentId])
  @@index([countryCode, parentId])
  @@index([active])
}

// Associates a Person with their current geographic locality. `personId` is
// unique because Phase 3A supports exactly one CURRENT active assignment
// per person — reassigning updates this same row's geographyId/assignedAt
// rather than creating a new one. Ancestors (Region/Division/Subdivision/
// etc.) are derived through Geography.parentId, never redundantly stored
// here. Historical movement tracking is an explicitly deferred future
// phase; this table represents "current residence/locality" only, not
// place of birth or origin.
model GeographicAssignment {
  id          String           @id @default(uuid())
  personId    String           @unique
  geographyId String
  assignedAt  DateTime         @default(now())
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  geography Geography @relation(fields: [geographyId], references: [id])

  @@index([geographyId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}
